<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ThixShot.App" RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="#FBFAF8"/>
      <Setter Property="Foreground" Value="#262322"/>
      <Setter Property="FontFamily" Value="Inter, Segoe UI, Helvetica Neue, sans-serif"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#DFDBD6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#C34B3E"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#AC3B31"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter"><Setter Property="Background" Value="#96352D"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.flat">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <Style Selector="Button.active"><Setter Property="Background" Value="#F6E2DA"/><Setter Property="Foreground" Value="#9E3C32"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="Button:disabled"><Setter Property="Opacity" Value="0.6"/></Style>
    <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="7"/><Setter Property="MinHeight" Value="34"/></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="7"/></Style>
  </Application.Styles>
</Application>
